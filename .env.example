# =============================================================================
# AZenthera AI — environment variables
# Copy to .env.local for local dev. Set the same values in the Vercel project.
# =============================================================================

# --- ElevenLabs Conversational AI (Voice Agents "Try it yourself") ----------
# Server-only secret. Never expose with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
# The Conversational AI agent id created in the ElevenLabs dashboard.
# The agent must have prompt + first_message OVERRIDES enabled in its security
# settings, and a max call duration set as a server-side backstop.
ELEVENLABS_AGENT_ID=

# --- Optional: site-inspection summary --------------------------------------
# If set, /api/inspect uses an LLM to summarize the visitor's website into a
# tight business brief. If unset, a heuristic extract is used instead.
OPENAI_API_KEY=

# --- Optional: durable rate limiting ----------------------------------------
# If set, /api/inspect and /api/voice/token use Upstash for IP rate limiting.
# If unset, a best-effort in-memory limiter is used (NOT durable on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Contact form (already used by ContactForm) -----------------------------
# Override the form submission endpoint (default: FormSubmit.co).
NEXT_PUBLIC_CONTACT_ENDPOINT=
